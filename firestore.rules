rules_version = '2';

// CoachingCompass public demo.
// The shared sample roster is world-readable and never writable from the app;
// visitors' own changes live in their browser's localStorage.
service cloud.firestore {
  match /databases/{database}/documents {
    match /demoPlayers/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else (including any legacy collections) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
